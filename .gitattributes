# =============================================================
#  .gitattributes — Turtle D-Day
#  1) Normalise les fins de ligne du texte.
#  2) Fusion "intelligente" des fichiers YAML Unity.
#  3) Envoie les gros fichiers binaires dans Git LFS.
# =============================================================

# --- Texte : fins de ligne normalisées dans le dépôt ---
* text=auto

*.cs        text diff=csharp
*.shader    text
*.hlsl      text
*.cginc     text
*.uxml      text
*.uss       text
*.json      text
*.md        text
*.yml       text
*.asmdef    text
*.asmref    text

# --- Fichiers YAML Unity (scènes, prefabs, assets) ---
# "merge=unityyamlmerge" : utilise l'outil de fusion de Unity (voir cours 01).
# "linguist-generated" : GitHub ne les compte pas dans les stats de langage.
*.unity       text merge=unityyamlmerge eol=lf linguist-generated
*.prefab      text merge=unityyamlmerge eol=lf linguist-generated
*.asset       text merge=unityyamlmerge eol=lf linguist-generated
*.mat         text merge=unityyamlmerge eol=lf linguist-generated
*.anim        text merge=unityyamlmerge eol=lf linguist-generated
*.controller  text merge=unityyamlmerge eol=lf linguist-generated
*.overrideController text merge=unityyamlmerge eol=lf linguist-generated
*.physicMaterial text merge=unityyamlmerge eol=lf linguist-generated
*.meta        text merge=unityyamlmerge eol=lf linguist-generated
*.inputactions text eol=lf

# --- Binaires lourds : Git LFS ---
# Modèles 3D
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
# Images
*.png   filter=lfs diff=lfs merge=lfs -text
*.jpg   filter=lfs diff=lfs merge=lfs -text
*.jpeg  filter=lfs diff=lfs merge=lfs -text
*.tga   filter=lfs diff=lfs merge=lfs -text
*.psd   filter=lfs diff=lfs merge=lfs -text
*.tif   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
# Audio
*.wav   filter=lfs diff=lfs merge=lfs -text
*.mp3   filter=lfs diff=lfs merge=lfs -text
*.ogg   filter=lfs diff=lfs merge=lfs -text
# Vidéo
*.mp4   filter=lfs diff=lfs merge=lfs -text
*.mov   filter=lfs diff=lfs merge=lfs -text
# Polices
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text
# Données de lumière et terrains (gros binaires générés par Unity)
LightingData.asset filter=lfs diff=lfs merge=lfs -text
*.terrainlayer filter=lfs diff=lfs merge=lfs -text
Assets/**/Terrain*/*.asset filter=lfs diff=lfs merge=lfs -text
# Bibliothèques natives
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
