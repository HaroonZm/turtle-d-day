{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(./Library/**)",
      "Read(./Temp/**)",
      "Read(./Logs/**)",
      "Read(./UserSettings/**)",
      "Read(./obj/**)",
      "Read(./*.csproj)",
      "Edit(./Library/**)",
      "Edit(./Temp/**)",
      "Edit(./ProjectSettings/ProjectVersion.txt)",
      "Read(./.env)",
      "Read(./**/*.ulf)",
      "Read(./**/*.alf)"
    ]
  }
}
