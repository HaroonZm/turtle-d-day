# =============================================================
#  .gitignore Unity — Turtle D-Day
#  Règle d'or : on versionne ce qui est SOURCE (Assets, Packages,
#  ProjectSettings) et jamais ce que Unity peut REGÉNÉRER.
# =============================================================

# --- Dossiers générés par Unity (cache d'import, compilation, logs) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Sorties de build par plateforme
*.apk
*.aab
*.unitypackage
*.app
/[Bb]uild[Ss]ettings/

# Rapports de crash
sysinfo.txt
crashlytics-build.properties

# --- Fichiers générés par les IDE (Visual Studio, Rider, VS Code) ---
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Meta des fichiers ignorés générés par l'éditeur
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Divers ---
# Fichiers du package Multiplayer Play Mode (clones de l'éditeur)
/[Ll]ibrary/VP/
# Caches Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# Système
.DS_Store
Thumbs.db
desktop.ini

# Secrets (ne JAMAIS commiter de licences ou de clés)
*.ulf
*.alf
.env
